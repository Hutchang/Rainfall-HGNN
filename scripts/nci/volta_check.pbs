#!/usr/bin/env bash
# Check .venv on one V100: torch sees the GPU, is built for sm_70, runs a CUDA
# operation, then times NCI_EPOCHS (default 1) of NCI_MODEL_CONFIG on fold NCI_FOLDS.
#   qsub -v NCI_MODEL_CONFIG=<config>,NCI_FOLDS=0 scripts/nci/volta_check.pbs
#PBS -P no50
#PBS -q gpuvolta
#PBS -N rainflow-volta-check
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=90GB
#PBS -l jobfs=10GB
#PBS -l walltime=00:45:00
#PBS -l storage=scratch/no50+gdata/no50
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?submit this script through PBS from the repository root}"
py=.venv/bin/python
export PYTHONDONTWRITEBYTECODE=1 MPLBACKEND=Agg OMP_NUM_THREADS=${PBS_NCPUS:-1}
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
"$py" - <<'EOF'
import torch
print("torch", torch.__version__, "cuda", torch.version.cuda, "available", torch.cuda.is_available())
print("device", torch.cuda.get_device_name(0), "capability", torch.cuda.get_device_capability(0))
print("arch list", torch.cuda.get_arch_list())
x = torch.randn(1024, 1024, device="cuda")
print("matmul ok", float((x @ x).sum()) == float((x @ x).sum()))
EOF
out=experiments/volta-check-${PBS_JOBID%%.*}
started=$(date +%s)
"$py" -B -u -m src.models.run "${NCI_MODEL_CONFIG:?}" --device cuda --epochs "${NCI_EPOCHS:-1}" \
    --folds "${NCI_FOLDS:-0}" --output-dir "$out"
printf 'VOLTA_CHECK=DONE seconds=%s output=%s\n' "$(( $(date +%s) - started ))" "$out"
