#!/usr/bin/env bash
# Component 06 training on one Gadi GPU: the HGNN plus IDW and network mean on the same
# rows. The locked torch is built for CUDA 12.6, so the same .venv runs on gpuvolta
# (V100) and dgxa100 (A100); pick the queue with qsub -q and matching -l resources.
#   qsub -v NCI_MODEL_CONFIG=config/models/d09_round_robin_grs.yaml,NCI_OUTPUT_DIR=experiments/nci/d09-grs scripts/nci/train.pbs
# NCI_EPOCHS=1 with a short walltime times one epoch before a full run is booked.
# Short jobs start sooner, so a full run can be split into one job per fold:
#   NCI_FOLDS=0 (or 1:3; qsub -v separates its variables with commas) trains only those
#   folds and writes a PARTIAL report. When every fold has finished, join them with
#   python -m src.models.combine_folds <joined> <fold run> ... and score all methods with
#   NCI_PREDICT_FROM=<joined>/best.pt. NCI_MODEL_SEED=<n> replaces seeds_file's model seed.
# NCI_DEVICE=cpu trains on CPU instead; scripts/nci/train_cpu.pbs requests a normal-queue
# CPU node and sets it, and scripts/nci/train_volta.pbs requests a gpuvolta V100.
# NCI_RESUME=1 continues a run that stopped (for example at its walltime) in its own
# NCI_OUTPUT_DIR from last.pt, exactly where it stopped.
# PBS emails the job owner when the job ends or is aborted (-m ae).
#PBS -P no50
#PBS -q dgxa100
#PBS -N rainflow-train
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=128GB
#PBS -l jobfs=10GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/no50+gdata/no50
#PBS -l wd
#PBS -j oe
#PBS -m ae
set -euo pipefail

if [[ -z ${PBS_JOBID:-} || -z ${PBS_O_WORKDIR:-} ]]; then
    printf 'BLOCKED: submit this script through PBS from the repository root.\n' >&2
    exit 1
fi
if [[ -z ${NCI_MODEL_CONFIG:-} || -z ${NCI_OUTPUT_DIR:-} ]]; then
    printf 'BLOCKED: NCI_MODEL_CONFIG and NCI_OUTPUT_DIR must be passed with qsub -v.\n' >&2
    exit 1
fi
if [[ -n ${NCI_EPOCHS:-} && ! ${NCI_EPOCHS} =~ ^[1-9][0-9]{0,2}$ ]]; then
    printf 'BLOCKED: NCI_EPOCHS must be a whole number from 1 to 999.\n' >&2
    exit 1
fi
if [[ -n ${NCI_FOLDS:-} && ! ${NCI_FOLDS} =~ ^[0-4](:[0-4]){0,4}$ ]]; then
    printf 'BLOCKED: NCI_FOLDS must be fold numbers 0 to 4 joined by colons, e.g. 0 or 1:3.\n' >&2
    exit 1
fi
if [[ -n ${NCI_MODEL_SEED:-} && ! ${NCI_MODEL_SEED} =~ ^[0-9]{1,9}$ ]]; then
    printf 'BLOCKED: NCI_MODEL_SEED must be a whole number.\n' >&2
    exit 1
fi
if [[ -n ${NCI_PREDICT_FROM:-} && -n ${NCI_FOLDS:-} ]]; then
    printf 'BLOCKED: NCI_PREDICT_FROM scores all folds; do not set NCI_FOLDS with it.\n' >&2
    exit 1
fi
cd "$PBS_O_WORKDIR"
if [[ -n ${NCI_PREDICT_FROM:-} && ! -f $NCI_PREDICT_FROM ]]; then
    printf 'BLOCKED: NCI_PREDICT_FROM=%s is not a file.\n' "$NCI_PREDICT_FROM" >&2
    exit 1
fi
device=${NCI_DEVICE:-cuda}
if [[ $device != cuda && $device != cpu ]]; then
    printf 'BLOCKED: NCI_DEVICE must be cuda or cpu.\n' >&2
    exit 1
fi
if [[ $device == cuda && ${PBS_NGPUS:-0} != 1 ]]; then
    printf 'BLOCKED: training requires exactly one allocated GPU (or NCI_DEVICE=cpu).\n' >&2
    exit 1
fi
if [[ -n ${NCI_RESUME:-} && $NCI_RESUME != 1 ]]; then
    printf 'BLOCKED: NCI_RESUME must be 1 or unset.\n' >&2
    exit 1
fi
if [[ ${NCI_RESUME:-} == 1 ]]; then
    if [[ ! -f $NCI_OUTPUT_DIR/last.pt ]]; then
        printf 'BLOCKED: NCI_RESUME=1 needs %s/last.pt from the stopped run.\n' "$NCI_OUTPUT_DIR" >&2
        exit 1
    fi
elif [[ -e $NCI_OUTPUT_DIR ]]; then
    printf 'BLOCKED: %s already exists; runs are never overwritten.\n' "$NCI_OUTPUT_DIR" >&2
    exit 1
fi

# The Linux environment must already exist. Compute nodes do not install/download.
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=${PBS_NCPUS:-1}
export MPLBACKEND=Agg
options=()
if [[ -n ${NCI_EPOCHS:-} ]]; then
    options+=(--epochs "$NCI_EPOCHS")
fi
if [[ -n ${NCI_FOLDS:-} ]]; then
    options+=(--folds "${NCI_FOLDS//:/,}")
fi
if [[ -n ${NCI_MODEL_SEED:-} ]]; then
    options+=(--model-seed "$NCI_MODEL_SEED")
fi
if [[ -n ${NCI_PREDICT_FROM:-} ]]; then
    options+=(--predict-from "$NCI_PREDICT_FROM")
fi
if [[ ${NCI_RESUME:-} == 1 ]]; then
    options+=(--resume)
fi

printf 'PBS job: %s; host: %s; UTC start: %s\n' "$PBS_JOBID" "$(hostname)" "$(date -u +%FT%TZ)"
git rev-parse HEAD
git status --short
if [[ ! -x .venv/bin/python ]]; then
    printf 'BLOCKED: .venv/bin/python is missing; run scripts/nci/prepare_environment.pbs.\n' >&2
    exit 1
fi
if [[ $device == cuda ]]; then
    nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
    bash scripts/nci/preflight.sh --cuda "$NCI_MODEL_CONFIG"
else
    bash scripts/nci/preflight.sh "$NCI_MODEL_CONFIG"
fi
started=$(date +%s)
.venv/bin/python -B -u -m src.models.run "$NCI_MODEL_CONFIG" --device "$device" \
    --output-dir "$NCI_OUTPUT_DIR" "${options[@]}"
printf 'TRAIN_STATUS=DONE seconds=%s output=%s UTC end: %s\n' \
    "$(( $(date +%s) - started ))" "$NCI_OUTPUT_DIR" "$(date -u +%FT%TZ)"
